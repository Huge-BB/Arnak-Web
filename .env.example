# Directory for single-process LAN account and room persistence. Never commit it.
ARNAK_DATA_DIR=.arnak-data

# Comma-separated browser origins permitted to call the room service.
# Set this to your deployed Web host or LAN Vite address in production.
ARNAK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authoritative room-service port.
ARNAK_ROOM_PORT=8787
